{
  "name": "@garrison/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "commands:deploy": "tsx --env-file-if-exists=../../.env src/deploy-commands.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@garrison/brand": "workspace:*",
    "@garrison/db": "workspace:*",
    "discord.js": "^14.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
