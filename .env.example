# Discord Developer Portal → your application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands to one test server for instant updates
DISCORD_DEV_GUILD_ID=

# Supabase → Connect → connection strings. See SECURITY.md before filling these in.
# Bot runtime: the least-privilege garrison_bot role, pooled "Transaction" string (port 6543)
DATABASE_URL=postgresql://garrison_bot.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations only: the postgres role, "Session" string (port 5432). Don't give this to the bot.
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

LOG_LEVEL=info
